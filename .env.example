# These are placeholders; NEVER commit your actual token or bot credentials.
CTFOU_ACCESS_TOKEN=your_ctfd_access_token
TELEGRAM_BOT_TOKEN=123456:your_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# AI solver is optional. Without it, passive extractors still run.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
FLAG_PREFIXES=THMH
SOLVE_EXISTING_ON_FIRST_RUN=false
NOTIFY_UNSOLVED=false
MAX_SOLVES_PER_RUN=3
RETRY_UNSOLVED_HOURS=6
